{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "NightWatch incident report",
  "type": "object",
  "required": [
    "incident_id",
    "run_id",
    "card_id",
    "outcome",
    "counted_recovery_success",
    "detected_at",
    "closed_at",
    "durations",
    "root_cause",
    "confidence",
    "audit",
    "ai_timeline",
    "measured",
    "comparison",
    "early_sign",
    "action",
    "verification",
    "residual",
    "pinned_window"
  ],
  "properties": {
    "incident_id": { "type": "string" },
    "run_id": { "type": "string" },
    "card_id": { "type": "string" },
    "outcome": {
      "enum": [
        "recovered",
        "expired_before_approval",
        "expired_before_execution",
        "aborted_by_operator",
        "audit_rejected",
        "verification_failed",
        "action_failed",
        "budget_exhausted",
        "no_remediation_path",
        "safety_restore_failed",
        "unresolved",
        "recovered_mitigated"
      ]
    },
    "counted_recovery_success": { "type": "boolean" },
    "detected_at": { "type": "string" },
    "closed_at": { "type": "string" },
    "durations": {
      "type": "object",
      "required": ["inject_to_detect_secs", "detect_to_close_secs", "approve_to_verified_secs"],
      "properties": {
        "inject_to_detect_secs": { "type": ["number", "null"] },
        "detect_to_close_secs": { "type": ["number", "null"] },
        "approve_to_verified_secs": { "type": ["number", "null"] }
      },
      "additionalProperties": false
    },
    "root_cause": { "$ref": "agent-report.schema.json#/properties/root_cause" },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "audit": {
      "type": "object",
      "required": ["status", "timeline_status", "checks"],
      "properties": {
        "status": { "enum": ["passed", "failed"] },
        "timeline_status": { "enum": ["accepted", "rejected"] },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "status", "reason"],
            "properties": {
              "id": {
                "enum": [
                  "evidence_integrity",
                  "direct_origin",
                  "cause_action",
                  "timeline_onset",
                  "timeline_order"
                ]
              },
              "status": { "enum": ["passed", "failed", "skipped"] },
              "reason": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "ai_timeline": { "$ref": "agent-report.schema.json#/properties/timeline" },
    "measured": { "$ref": "timeline.schema.json#/properties/measured" },
    "truth": { "$ref": "timeline.schema.json#/properties/truth" },
    "comparison": {
      "type": "object",
      "required": [
        "ai_onset_minus_truth_secs",
        "ai_onset_minus_measured_secs",
        "detect_minus_truth_secs",
        "detect_minus_ai_onset_secs"
      ],
      "properties": {
        "ai_onset_minus_truth_secs": { "type": ["number", "null"] },
        "ai_onset_minus_measured_secs": { "type": ["number", "null"] },
        "detect_minus_truth_secs": { "type": ["number", "null"] },
        "detect_minus_ai_onset_secs": { "type": ["number", "null"] }
      },
      "additionalProperties": false
    },
    "early_sign": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["seq", "t", "node", "axis", "value", "errors_then"],
          "properties": {
            "seq": { "type": "integer" },
            "t": { "type": "integer" },
            "node": { "type": "string" },
            "axis": { "enum": ["traffic", "errors", "latency", "saturation", "liveness"] },
            "value": { "type": "number" },
            "errors_then": { "type": "number" }
          },
          "additionalProperties": false
        }
      ]
    },
    "action": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["id", "target", "executed_at", "steps"],
          "properties": {
            "id": { "type": "string" },
            "target": { "type": "string" },
            "executed_at": { "type": "string" },
            "steps": {
              "type": "array",
              "items": { "type": "object", "additionalProperties": true }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "verification": {
      "type": "object",
      "required": ["windows", "safety_recovery"],
      "properties": {
        "windows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["index", "passed", "observed"],
            "properties": {
              "index": { "type": "integer" },
              "passed": { "type": "boolean" },
              "observed": { "type": "object", "additionalProperties": true }
            },
            "additionalProperties": false
          }
        },
        "safety_recovery": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "residual": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node", "status", "note_zh"],
        "properties": {
          "node": { "type": "string" },
          "status": { "type": "string" },
          "note_zh": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "pinned_window": {
      "type": "object",
      "required": ["from_t", "to_t", "step_secs", "count"],
      "properties": {
        "from_t": { "type": "integer" },
        "to_t": { "type": "integer" },
        "step_secs": { "type": "integer" },
        "count": { "type": "integer" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
