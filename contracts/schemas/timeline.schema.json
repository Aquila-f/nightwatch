{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "NightWatch incident timeline",
  "type": "object",
  "required": ["detected_at", "from_t", "to_t", "system", "ai", "measured"],
  "properties": {
    "detected_at": { "type": "string" },
    "from_t": { "type": "integer" },
    "to_t": { "type": "integer" },
    "system": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["t", "kind", "label_zh"],
        "properties": {
          "t": { "type": "integer" },
          "seq": { "type": "integer" },
          "kind": { "type": "string" },
          "label_zh": { "type": "string" },
          "tool": { "type": "string" },
          "node": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "ai": {
      "type": "object",
      "required": ["status", "onset", "propagation"],
      "properties": {
        "status": { "enum": ["accepted", "rejected"] },
        "onset": {
          "type": "object",
          "required": ["node", "t", "signal"],
          "properties": {
            "node": { "type": "string" },
            "t": { "type": "integer" },
            "signal": { "enum": ["err", "p95", "sat", "up"] }
          },
          "additionalProperties": false
        },
        "propagation": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": ["node", "t", "signal"],
            "properties": {
              "node": { "type": "string" },
              "t": { "type": "integer" },
              "signal": { "enum": ["err", "p95", "sat", "up"] }
            },
            "additionalProperties": false
          }
        },
        "reasons": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "measured": {
      "type": "object",
      "required": ["deviations"],
      "properties": {
        "deviations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["node", "axis", "t"],
            "properties": {
              "node": { "type": "string" },
              "axis": { "enum": ["traffic", "errors", "latency", "saturation", "liveness"] },
              "t": { "type": "integer" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "truth": {
      "type": "object",
      "required": ["card_id", "t_injected", "curve"],
      "properties": {
        "card_id": { "type": "string" },
        "t_injected": { "type": "integer" },
        "curve": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": ["number", "string"] }
          }
        },
        "root": { "type": "string" },
        "mechanism_family": { "type": "string" },
        "expected_action": { "type": "string" },
        "expected_order": { "type": "array", "items": { "type": "string" } },
        "decoys": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
