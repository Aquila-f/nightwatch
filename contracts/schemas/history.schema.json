{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "NightWatch node history",
  "type": "object",
  "required": ["node", "kind", "t_from", "t_to", "step_secs", "axes", "points", "baseline", "band", "sat_label"],
  "properties": {
    "node": { "type": "string" },
    "kind": {
      "enum": ["service", "datastore", "queue", "volume", "synthetic", "external"]
    },
    "t_from": { "type": "integer" },
    "t_to": { "type": "integer" },
    "step_secs": { "type": "integer" },
    "axes": {
      "const": ["t", "rps", "err", "p95", "sat", "up"]
    },
    "points": {
      "type": "array",
      "maxItems": 26,
      "items": {
        "type": "array",
        "minItems": 6,
        "maxItems": 6,
        "items": { "type": "number" }
      }
    },
    "baseline": {
      "type": "object",
      "required": ["rps", "err", "p95", "sat"],
      "properties": {
        "rps": { "type": "number" },
        "err": { "type": "number" },
        "p95": { "type": "number" },
        "sat": { "type": "number" }
      },
      "additionalProperties": false
    },
    "band": {
      "type": "object",
      "required": ["err_max", "p95_max", "sat_max"],
      "properties": {
        "err_max": { "type": "number" },
        "p95_max": { "type": "number" },
        "sat_max": { "type": "number" }
      },
      "additionalProperties": false
    },
    "sat_label": { "type": "string" }
  },
  "additionalProperties": false
}
