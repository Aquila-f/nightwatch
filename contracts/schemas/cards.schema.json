{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "NightWatch fault cards",
  "type": "object",
  "required": [
    "schema_version",
    "cards"
  ],
  "properties": {
    "schema_version": {
      "const": "nightwatch.cards.v2"
    },
    "cards": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title_zh",
          "symptom_zh",
          "story_zh",
          "difficulty",
          "on_stage",
          "lease_secs",
          "revision",
          "knobs",
          "expect",
          "truth",
          "verify"
        ],
        "properties": {
          "id": {
            "enum": [
              "payment_failure_ramp",
              "recommendation_cache_growth",
              "kafka_consumer_backlog",
              "payment_failure_with_cart_decoy",
              "email_memory_growth"
            ]
          },
          "title_zh": {
            "type": "string"
          },
          "symptom_zh": {
            "type": "string"
          },
          "story_zh": {
            "type": "string"
          },
          "difficulty": {
            "enum": [
              "easy",
              "medium",
              "hard"
            ]
          },
          "on_stage": {
            "enum": [
              "primary",
              "secondary",
              "backup",
              "off"
            ]
          },
          "lease_secs": {
            "type": "integer",
            "minimum": 901
          },
          "revision": {
            "type": "string"
          },
          "knobs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "service",
                "knob",
                "curve"
              ],
              "properties": {
                "service": {
                  "type": "string"
                },
                "knob": {
                  "type": "string"
                },
                "curve": {
                  "oneOf": [
                    {
                      "type": "object",
                      "required": [
                        "type",
                        "value"
                      ],
                      "properties": {
                        "type": {
                          "const": "const"
                        },
                        "value": {
                          "type": [
                            "number",
                            "string",
                            "boolean"
                          ]
                        },
                        "noise_stddev": {
                          "type": "number"
                        }
                      },
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "required": [
                        "type",
                        "from",
                        "to",
                        "duration_secs"
                      ],
                      "properties": {
                        "type": {
                          "const": "linear"
                        },
                        "from": {
                          "type": [
                            "number",
                            "string"
                          ]
                        },
                        "to": {
                          "type": [
                            "number",
                            "string"
                          ]
                        },
                        "duration_secs": {
                          "type": "number"
                        },
                        "noise_stddev": {
                          "type": "number"
                        }
                      },
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "required": [
                        "type",
                        "from",
                        "to",
                        "duration_secs"
                      ],
                      "properties": {
                        "type": {
                          "const": "exp"
                        },
                        "from": {
                          "type": [
                            "number",
                            "string"
                          ]
                        },
                        "to": {
                          "type": [
                            "number",
                            "string"
                          ]
                        },
                        "duration_secs": {
                          "type": "number"
                        },
                        "noise_stddev": {
                          "type": "number"
                        }
                      },
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "required": [
                        "type",
                        "levels",
                        "hold_secs"
                      ],
                      "properties": {
                        "type": {
                          "const": "step"
                        },
                        "levels": {
                          "type": "array",
                          "items": {
                            "type": [
                              "number",
                              "string"
                            ]
                          }
                        },
                        "hold_secs": {
                          "type": "number"
                        },
                        "noise_stddev": {
                          "type": "number"
                        }
                      },
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "expect": {
            "type": "object",
            "required": [
              "detect_after_secs"
            ],
            "properties": {
              "detect_after_secs": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              },
              "expected_outcome": {
                "type": "string",
                "enum": [
                  "recovered",
                  "expired_before_approval",
                  "expired_before_execution",
                  "aborted_by_operator",
                  "audit_rejected",
                  "verification_failed",
                  "action_failed",
                  "budget_exhausted",
                  "no_remediation_path",
                  "safety_restore_failed",
                  "unresolved",
                  "recovered_mitigated"
                ],
                "description": "評測腳本比對用:這張卡修完應該落在哪個結局"
              }
            },
            "additionalProperties": false
          },
          "truth": {
            "type": "object",
            "required": [
              "root",
              "mechanism_family",
              "expected_action",
              "expected_order",
              "decoys"
            ],
            "properties": {
              "root": {
                "type": "string"
              },
              "mechanism_family": {
                "type": "string"
              },
              "expected_action": {
                "type": "string"
              },
              "expected_order": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "decoys": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
          "verify": {
            "type": "object",
            "required": [
              "settle_max_secs",
              "predicates"
            ],
            "properties": {
              "settle_max_secs": {
                "type": "integer"
              },
              "predicates": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "kind",
                    "node"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "node_extra_below",
                        "node_extra_monotonic_down",
                        "node_axis_in_band"
                      ]
                    },
                    "node": {
                      "type": "string"
                    },
                    "extra": {
                      "type": "string"
                    },
                    "max": {
                      "type": "number"
                    },
                    "axis": {
                      "enum": [
                        "traffic",
                        "errors",
                        "latency",
                        "saturation",
                        "liveness"
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
