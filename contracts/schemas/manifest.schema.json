{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "NightWatch deployment manifest",
  "type": "object",
  "required": ["schema_version", "nodes", "edges", "checks", "mechanism_families", "actions"],
  "properties": {
    "schema_version": { "const": "nightwatch.manifest.v2" },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "layout"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "kind": {
            "enum": ["service", "datastore", "queue", "volume", "synthetic", "external"]
          },
          "layout": {
            "type": "object",
            "required": ["row", "col"],
            "properties": {
              "row": { "type": "integer" },
              "col": { "type": "integer" }
            },
            "additionalProperties": false
          },
          "health_url": { "type": "string" },
          "sat": { "enum": ["pool", "queue", "disk", "mem"] },
          "owner": { "type": "string" },
          "selector": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "kind"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "kind": { "enum": ["uses", "publishes", "consumes", "calls"] }
        },
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "url", "meaning_zh"],
        "properties": {
          "id": { "type": "string" },
          "url": { "type": "string" },
          "meaning_zh": { "type": "string" },
          "node": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "mechanism_families": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "targets", "families", "steps", "description_zh"],
        "properties": {
          "id": { "type": "string" },
          "targets": { "type": "array", "items": { "type": "string" } },
          "families": { "type": "array", "items": { "type": "string" } },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind"],
              "properties": {
                "kind": { "enum": ["put_config", "set_knob", "http_post"] },
                "revision": { "type": "string" },
                "knob": { "type": "string" },
                "value": { "type": ["string", "number", "boolean", "null"] },
                "path": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "mitigation_only": { "type": "boolean" },
          "description_zh": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "runtime_targets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "description_zh",
          "known_good_revision",
          "known_good_knobs",
          "knobs",
          "maintenance"
        ],
        "properties": {
          "description_zh": {
            "type": "string"
          },
          "known_good_revision": {
            "type": "string",
            "minLength": 1
          },
          "known_good_knobs": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          },
          "knobs": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "required": [
                "type",
                "description_zh"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "number",
                    "string",
                    "boolean"
                  ]
                },
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                },
                "enum": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  }
                },
                "description_zh": {
                  "type": "string"
                },
                "mitigation": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          },
          "maintenance": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "path",
                "description_zh"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^/internal/[A-Za-z0-9_/-]+$"
                },
                "description_zh": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
